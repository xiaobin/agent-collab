{
  "schema_version": 1,
  "bot_id": "replace-me",
  "revision": 1,
  "goal_ref": "REPLACE-WITH-GOAL-REF",
  "display_name": "Replace with a human-readable name",
  "description": "Replace every value in this template before validation. No real project or user identifier belongs in the public package.",
  "identity": {
    "instructions_ref": null,
    "owner_ref": "replace-with-local-owner-ref",
    "tags": ["replace-me"]
  },
  "adapter": {
    "name": "fake",
    "version": "1",
    "config_ref": ".herdr/bots/replace-me/adapter-config.json"
  },
  "runtime": {
    "kind": "process",
    "agent": null,
    "concurrency": "forbid",
    "lock_ttl_seconds": 90,
    "heartbeat_seconds": 5
  },
  "workspace": {
    "root": ".herdr/bots/replace-me",
    "read_scope": [],
    "write_scope": [".herdr/bots/replace-me"]
  },
  "permissions": {
    "autonomy_ceiling": "L1",
    "project_write_scope": [],
    "network_read": false,
    "network_write": false,
    "external_actions": "deny",
    "bot_administration": "deny",
    "commands": [],
    "secret_refs": []
  },
  "triggers": [
    {
      "type": "manual",
      "skip_if_running": true
    }
  ],
  "triage": {
    "mode": "suggest_only",
    "triage_trigger": "herdr_batch",
    "batch_interval_seconds": 1800,
    "max_batch_events": 20,
    "max_context_events": 40,
    "human_report_max_items_per_group": 5,
    "human_report_max_lines": 40
  },
  "outputs": [
    {
      "type": "herdr_panel",
      "format": "summary"
    },
    {
      "type": "local_file",
      "path": ".herdr/bots/replace-me/reports",
      "format": "markdown_and_jsonl"
    }
  ],
  "memory": {
    "mode": "private",
    "path": ".herdr/bots/replace-me/memory",
    "retention_days": 30,
    "max_bytes": 1048576
  },
  "health": {
    "stale_after_seconds": 1800,
    "max_consecutive_failures": 3
  },
  "escalation": {
    "needs_user_route": "herdr_panel",
    "quiet_hours": null,
    "max_items_per_group": 5
  }
}